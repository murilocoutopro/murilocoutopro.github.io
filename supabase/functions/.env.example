# Apenas no servidor / Edge Functions > Secrets. Nunca usar prefixo VITE_.
# SUPABASE_URL e SUPABASE_SECRET_KEYS (ou SERVICE_ROLE_KEY legado) são
# fornecidos pelo Supabase hospedado. Não copie essas chaves para o frontend.
ALLOWED_ORIGINS=http://127.0.0.1:5188,http://localhost:5188
# Gere um valor aleatório longo para pseudonimizar chaves do limitador.
REGISTRATION_RATE_LIMIT_SALT=
# Opcional: ao configurar, tokens válidos serão obrigatórios no servidor.
TURNSTILE_SECRET_KEY=
